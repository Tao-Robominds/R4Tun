{
    "description": "Hough line detection and segment pattern inference parameters for Tunnel 5-1 (7-segment)",
    "physical_constants": {
        "ring_spacing_m": 1.2,
        "k_height_mm": 1079.92,
        "ab_height_mm": 3239.77,
        "segment_width_mm": 1200,
        "oblique_angle_deg": 7.52,
        "resolution": 0.005
    },
    "preprocessing": {
        "binary_threshold": 115,
        "dilation_kernel_size": 5,
        "dilation_iterations": 2
    },
    "hough_oblique": {
        "rho": 1,
        "theta_deg": 1.0,
        "threshold": 40,
        "min_length": 130,
        "max_gap": 50,
        "angle_positive_min": 6.0,
        "angle_positive_max": 9.0,
        "angle_negative_min": -9.0,
        "angle_negative_max": -6.0
    },
    "hough_horizontal": {
        "threshold": 40,
        "min_length": 100,
        "max_gap": 10,
        "angle_tolerance": 1
    },
    "hough_vertical": {
        "threshold": 300,
        "angle_tolerance": 0.5,
        "filter_rings": 5
    },
    "line_processing": {
        "merge_distance_threshold": 10.0,
        "intersection_merge_threshold": 6,
        "pattern_tolerance": 10,
        "horizontal_pattern_tolerance": 50
    },
    "k_block_detection": {
        "description": "Generic K-block position detection for 7-segment tunnel",
        "method": "physical_offset_correction",
        "segment_count": 7,
        "wrap_around": true,
        "algorithm": {
            "step1": "Detect oblique lines with K_HEIGHT spacing between pos/neg slopes",
            "step2": "For 7-segment tunnels, K can be at any of 7 rotational positions",
            "step3": "Apply correction: actual_pos = detected_midpoint + (AB_HEIGHT + K_HEIGHT/2)",
            "step4": "Handle wrap-around: if pos > image_height, pos -= circumference",
            "step5": "Assign K position per ring based on local detection"
        },
        "formulas": {
            "offset_correction_px": "AB_HEIGHT + K_HEIGHT/2 = 755.9 px",
            "circumference_px": "K_HEIGHT + 6*AB_HEIGHT = 4103.7 px",
            "k_spacing_tolerance_px": 60
        },
        "notes": "7-segment tunnel with variable K positions. Uses physical constants only."
    }
}
