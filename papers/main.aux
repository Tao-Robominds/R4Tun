\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Sensitive preprocessing parameters retained for the deployment-time LLM loop. Selection rule: pooled $|\rho _{\mathrm  {Spearman}}|\geq 0.20$ vs canonical mIoU and evidence in $\geq 3$ of 6 calibration rings. The R4Tun-seed default is the value the regular-tunnel reference produces after schema mapping; values shown as $a (\to b)$ are clipped at deployment to the BO hard upper bound. Soft bounds are the $[p_{25}, p_{75}]$ envelope of the upper-quartile-mIoU regime across 180 successful preprocessing trials; hard bounds are the BO search-space limits.}}{11}{table.caption.15}\protected@file@percent }
\newlabel{tab:cal-sensitive-params}{{5}{11}{Sensitive preprocessing parameters retained for the deployment-time LLM loop. Selection rule: pooled $|\rho _{\mathrm {Spearman}}|\geq 0.20$ vs canonical mIoU and evidence in $\geq 3$ of 6 calibration rings. The R4Tun-seed default is the value the regular-tunnel reference produces after schema mapping; values shown as $a (\to b)$ are clipped at deployment to the BO hard upper bound. Soft bounds are the $[p_{25}, p_{75}]$ envelope of the upper-quartile-mIoU regime across 180 successful preprocessing trials; hard bounds are the BO search-space limits}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Diagnostic intrinsics that the LLM reflection loop reads at deployment. Selection rule: pooled $\rho _{\mathrm  {Spearman}}\geq 0.50$ vs canonical mIoU on the preprocessing-stage corpus and $\geq 90\%$ non-null across 360 successful trials. Strict threshold is the $p_{25}$ of the upper-quartile-mIoU regime; permissive threshold is the minimum value seen in the upper-quartile regime. Booleans use $0/1$.}}{11}{table.caption.16}\protected@file@percent }
\newlabel{tab:cal-diag-intrinsics}{{6}{11}{Diagnostic intrinsics that the LLM reflection loop reads at deployment. Selection rule: pooled $\rho _{\mathrm {Spearman}}\geq 0.50$ vs canonical mIoU on the preprocessing-stage corpus and $\geq 90\%$ non-null across 360 successful trials. Strict threshold is the $p_{25}$ of the upper-quartile-mIoU regime; permissive threshold is the minimum value seen in the upper-quartile regime. Booleans use $0/1$}{table.caption.16}{}}
\def\@LN@column{2}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Guardrail bundles emitted by the calibration. Each bundle returns a Boolean verdict from its rule (\texttt  {all\_of\_min}: every constituent intrinsic must clear its lower threshold; \texttt  {max\_below}: the constituent must be below its upper threshold). G\_stability uses the permutation-vs-fixed mIoU gap on 360 pooled trials; strict is the corpus median, permissive the $p_{75}$.}}{11}{table.caption.17}\protected@file@percent }
\newlabel{tab:cal-guardrails}{{7}{11}{Guardrail bundles emitted by the calibration. Each bundle returns a Boolean verdict from its rule (\texttt {all\_of\_min}: every constituent intrinsic must clear its lower threshold; \texttt {max\_below}: the constituent must be below its upper threshold). G\_stability uses the permutation-vs-fixed mIoU gap on 360 pooled trials; strict is the corpus median, permissive the $p_{75}$}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Per-ring fixed-class canonical mIoU on the 6 BO calibration rings. The baseline applies the gravity-anchored R4Tun seed parameters; the preprocessing-BO column reports the best preprocessing trial (detection at seed values), and the detection-BO column reports the best detection trial (preprocessing at seed values). $\Delta $ is the best-of-three minus baseline; the scoreboard motivates LLM tuning of preprocessing only.}}{11}{table.caption.18}\protected@file@percent }
\newlabel{tab:cal-scoreboard}{{8}{11}{Per-ring fixed-class canonical mIoU on the 6 BO calibration rings. The baseline applies the gravity-anchored R4Tun seed parameters; the preprocessing-BO column reports the best preprocessing trial (detection at seed values), and the detection-BO column reports the best detection trial (preprocessing at seed values). $\Delta $ is the best-of-three minus baseline; the scoreboard motivates LLM tuning of preprocessing only}{table.caption.18}{}}
