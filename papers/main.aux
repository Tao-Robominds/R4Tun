\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Guarded accept/abstain control on the 40-ring held-out panel.} (a)~The stabilised candidate0 mean mIoU is 0.3957 (see Table~\ref {tab:stage-decomposition} for the defendable stabilisation contribution); no quantitative held-out lift is claimed for the relative-reflection layer. (b)~Decision flow underlying the zero-accepted-degradation count: 29 rings carry no K-reflection candidate and abstain immediately, 11 rings are evaluated by the relative proxy and guardrails, 2 challengers are accepted, and 9 abstain to candidate0. The figure should be read together with Table~\ref {tab:relative-proxy} for the per-decision audit.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:stage-lift-flow}{{4}{9}{\textbf {Guarded accept/abstain control on the 40-ring held-out panel.} (a)~The stabilised candidate0 mean mIoU is 0.3957 (see Table~\ref {tab:stage-decomposition} for the defendable stabilisation contribution); no quantitative held-out lift is claimed for the relative-reflection layer. (b)~Decision flow underlying the zero-accepted-degradation count: 29 rings carry no K-reflection candidate and abstain immediately, 11 rings are evaluated by the relative proxy and guardrails, 2 challengers are accepted, and 9 abstain to candidate0. The figure should be read together with Table~\ref {tab:relative-proxy} for the per-decision audit}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Accept/abstain audit of the guarded relative-reflection layer on the 40-ring held-out panel. Candidate0 is the stabilised floor (Table~\ref {tab:stage-decomposition}). Relative reflection is evaluated only on rings with K-candidate evidence; all other rings abstain to candidate0. The accepted-degradation count is the panel-level safety property of the layer; no quantitative held-out lift is claimed.}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:relative-proxy}{{3}{9}{Accept/abstain audit of the guarded relative-reflection layer on the 40-ring held-out panel. Candidate0 is the stabilised floor (Table~\ref {tab:stage-decomposition}). Relative reflection is evaluated only on rings with K-candidate evidence; all other rings abstain to candidate0. The accepted-degradation count is the panel-level safety property of the layer; no quantitative held-out lift is claimed}{table.caption.12}{}}
\def\@LN@column{1}
\def\@LN@column{2}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Relative-proxy decision audit on the 11 rings where K-reflection candidates exist.} For each ring, candidate0 is the deployment floor, the relative candidate is the challenger selected by intrinsic features, and the oracle candidate is shown only after ground-truth audit to expose missed opportunity. Red stars mark the two guardrail-accepted challengers (4-4/r212 and 4-9/r363). Several abstained rings retain large oracle headroom (notably 4-7/r308 and 5-5/r259), confirming that the guardrails prioritise precision over recall: accepted changes improve the audit mIoU, while uncertain opportunities are left to candidate0 rather than deployed unsafely.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:relative-decisions}{{5}{10}{\textbf {Relative-proxy decision audit on the 11 rings where K-reflection candidates exist.} For each ring, candidate0 is the deployment floor, the relative candidate is the challenger selected by intrinsic features, and the oracle candidate is shown only after ground-truth audit to expose missed opportunity. Red stars mark the two guardrail-accepted challengers (4-4/r212 and 4-9/r363). Several abstained rings retain large oracle headroom (notably 4-7/r308 and 5-5/r259), confirming that the guardrails prioritise precision over recall: accepted changes improve the audit mIoU, while uncertain opportunities are left to candidate0 rather than deployed unsafely}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Accept/abstain audit for rings with K-reflection candidate evidence. mIoU columns are audit-only; they are computed after the GT-free decision to quantify accepted lift, abstention, and missed opportunity.}}{10}{table.caption.14}\protected@file@percent }
\newlabel{tab:relative-decisions}{{4}{10}{Accept/abstain audit for rings with K-reflection candidate evidence. mIoU columns are audit-only; they are computed after the GT-free decision to quantify accepted lift, abstention, and missed opportunity}{table.caption.14}{}}
