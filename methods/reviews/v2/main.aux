\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Step-wise adaptation results split by tunnel categories. Bars left to right: \mbox  {SAM4Tun} (static baseline), \mbox  {\textit  {Non-LLM}} (rule-based adaptation), \mbox  {m}, \mbox  {m+s}, \mbox  {m+s+k}. The rule baseline closes part of the gap on complex tunnels but stays flat on regular tunnels; LLM (\mbox  {m+s+k}) is highest in both categories. Error bars are bootstrap 95\% CIs.}}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:ablation-bar}{{10}{12}{Step-wise adaptation results split by tunnel categories. Bars left to right: \mbox {SAM4Tun} (static baseline), \mbox {\textit {Non-LLM}} (rule-based adaptation), \mbox {m}, \mbox {m+s}, \mbox {m+s+k}. The rule baseline closes part of the gap on complex tunnels but stays flat on regular tunnels; LLM (\mbox {m+s+k}) is highest in both categories. Error bars are bootstrap 95\% CIs}{figure.caption.14}{}}
