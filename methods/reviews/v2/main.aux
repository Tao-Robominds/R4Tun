\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Automated segmentation approaches arranged by their adaptation mechanisms. \texthl  {Expert-guided, LLM-driven methods can extend foundation-model pipelines by adding reasoning-guided parameter adaptation conditioned on structured context and encoded expert knowledge at deployment. In this work, we test one such mechanism (R4Tun) under controlled, cross-LLM, zero-label settings while keeping the underlying SAM4Tun operators fixed. R4Tun reuses expert-defined reference parameters, parameter bounds, and knowledge documents, so it reduces deployment-stage retuning within a predefined pipeline rather than removing expert knowledge from the workflow.}}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:paradigms}{{1}{2}{Automated segmentation approaches arranged by their adaptation mechanisms. \hl {Expert-guided, LLM-driven methods can extend foundation-model pipelines by adding reasoning-guided parameter adaptation conditioned on structured context and encoded expert knowledge at deployment. In this work, we test one such mechanism (R4Tun) under controlled, cross-LLM, zero-label settings while keeping the underlying SAM4Tun operators fixed. R4Tun reuses expert-defined reference parameters, parameter bounds, and knowledge documents, so it reduces deployment-stage retuning within a predefined pipeline rather than removing expert knowledge from the workflow.}}{figure.caption.1}{}}
