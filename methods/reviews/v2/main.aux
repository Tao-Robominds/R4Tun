\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \texthl  {Error composition as a fraction of ground-truth points (Opus-4.6 \mbox  {$m+s+k$} versus SAM4Tun baseline; 13 regular, 17 complex tunnels). FN: block predicted as background; FP: background predicted as block; swap: block predicted as the wrong block class. Adaptation removes false negatives; the residual error is dominated by class swaps.}}}{14}{table.caption.19}\protected@file@percent }
\newlabel{tab:error-composition}{{9}{14}{\hl {Error composition as a fraction of ground-truth points (Opus-4.6 \mbox {$m+s+k$} versus SAM4Tun baseline; 13 regular, 17 complex tunnels). FN: block predicted as background; FP: background predicted as block; swap: block predicted as the wrong block class. Adaptation removes false negatives; the residual error is dominated by class swaps.}}{table.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \texthl  {FP/FN error map drawn as a ring-by-\mbox  {$\theta $} raster. Each row is one ring, \mbox  {$\theta $} is the circumferential angle, and each point is coloured as correct, false negative, false positive, or class swap. The examples illustrate the two regimes: on regular tunnels such as tunnel 1-1, boundaries are often present but labels can rotate into neighbouring block classes, producing class swaps (23\% of evaluated points, with FN and FP each about 2\%); on complex tunnels such as tunnel 4-1, under-segmentation dominates and many block points are labelled as background (69\% FN). The map is intended to localise the remaining errors rather than to introduce a new performance metric.}}}{15}{figure.caption.20}\protected@file@percent }
\newlabel{fig:error-map}{{11}{15}{\hl {FP/FN error map drawn as a ring-by-\mbox {$\theta $} raster. Each row is one ring, \mbox {$\theta $} is the circumferential angle, and each point is coloured as correct, false negative, false positive, or class swap. The examples illustrate the two regimes: on regular tunnels such as tunnel 1-1, boundaries are often present but labels can rotate into neighbouring block classes, producing class swaps (23\% of evaluated points, with FN and FP each about 2\%); on complex tunnels such as tunnel 4-1, under-segmentation dominates and many block points are labelled as background (69\% FN). The map is intended to localise the remaining errors rather than to introduce a new performance metric.}}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \texthl  {Quantified structural constraints of the fixed SAM4Tun positional-labelling rule (Opus-4.6 \mbox  {$m+s+k$}, 30 tunnels; 13 regular, 17 complex). Values are computed from ground-truth versus predicted block labels; ``accuracy'' is ground-truth block-class accuracy. These quantities are properties of the labelling rule, not parameter values, so bounded adaptation can approach but not remove the resulting ceiling.}}}{16}{table.caption.21}\protected@file@percent }
\newlabel{tab:error-constraints}{{10}{16}{\hl {Quantified structural constraints of the fixed SAM4Tun positional-labelling rule (Opus-4.6 \mbox {$m+s+k$}, 30 tunnels; 13 regular, 17 complex). Values are computed from ground-truth versus predicted block labels; ``accuracy'' is ground-truth block-class accuracy. These quantities are properties of the labelling rule, not parameter values, so bounded adaptation can approach but not remove the resulting ceiling.}}{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \texthl  {Quantitative diagnostics for the four structural constraints (Opus-4.6 \mbox  {$m+s+k$}, 30 tunnels). (a)~C1: per-ring point density versus per-ring block accuracy; sparse rings (left) segment poorly and complex rings (red) cluster low. (b)~C2: per-ring K offset (in sector units) versus accuracy; beyond half a sector the K-anchor is mislocated and accuracy collapses, far more often on complex tunnels. (c)~C3: class recall by sector distance from K on K-aligned rings; the fixed 6-step template is near-uniform on regular tunnels but fails at the first offset on 7-segment complex tunnels. (d)~C4: per-ring ordering outcomes; most rings are pure rotations, but hard-coded walk direction yields mirror flips whose accuracy is about 0.08. (e)~error composition as a fraction of ground-truth points (baseline versus \mbox  {$m+s+k$}, by category): adaptation removes false negatives (under-segmentation) while the residual error is dominated by class swaps from the labelling rule, with false positives staying small. The panels localise and size the remaining errors; they do not introduce a new performance metric.}}}{16}{figure.caption.22}\protected@file@percent }
\newlabel{fig:error-mechanism}{{12}{16}{\hl {Quantitative diagnostics for the four structural constraints (Opus-4.6 \mbox {$m+s+k$}, 30 tunnels). (a)~C1: per-ring point density versus per-ring block accuracy; sparse rings (left) segment poorly and complex rings (red) cluster low. (b)~C2: per-ring K offset (in sector units) versus accuracy; beyond half a sector the K-anchor is mislocated and accuracy collapses, far more often on complex tunnels. (c)~C3: class recall by sector distance from K on K-aligned rings; the fixed 6-step template is near-uniform on regular tunnels but fails at the first offset on 7-segment complex tunnels. (d)~C4: per-ring ordering outcomes; most rings are pure rotations, but hard-coded walk direction yields mirror flips whose accuracy is about 0.08. (e)~error composition as a fraction of ground-truth points (baseline versus \mbox {$m+s+k$}, by category): adaptation removes false negatives (under-segmentation) while the residual error is dominated by class swaps from the labelling rule, with false positives staying small. The panels localise and size the remaining errors; they do not introduce a new performance metric.}}{figure.caption.22}{}}
