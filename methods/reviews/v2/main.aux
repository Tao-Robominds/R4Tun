\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \texthl  {Runtime trade-off of the tested R4Tun m+s+k setting. The base SAM4Tun processing time is $\sim $235\,s per tunnel; extra time is the additional LLM adaptation latency. Timings and API costs are implementation- and vendor-dependent; the table is intended to contextualise overhead, not to define a deployment benchmark.}}}{15}{table.caption.21}\protected@file@percent }
\newlabel{tab:runtime-tradeoff}{{9}{15}{\hl {Runtime trade-off of the tested R4Tun m+s+k setting. The base SAM4Tun processing time is $\sim $235\,s per tunnel; extra time is the additional LLM adaptation latency. Timings and API costs are implementation- and vendor-dependent; the table is intended to contextualise overhead, not to define a deployment benchmark.}}{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \texthl  {Mechanisms behind class confusion. The fixed pipeline detects K, assigns neighbouring blocks using an angular template, and then reprojects masks to 3D. Density variation, moving K positions, fixed-template drift, and reversed handedness explain why LLM parameter adaptation can improve boundary recovery while still leaving an absolute mIoU ceiling under a single reference.}}}{16}{figure.caption.20}\protected@file@percent }
\newlabel{fig:error-mechanism}{{12}{16}{\hl {Mechanisms behind class confusion. The fixed pipeline detects K, assigns neighbouring blocks using an angular template, and then reprojects masks to 3D. Density variation, moving K positions, fixed-template drift, and reversed handedness explain why LLM parameter adaptation can improve boundary recovery while still leaving an absolute mIoU ceiling under a single reference.}}{figure.caption.20}{}}
