\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces \texthl  {Positioning R4Tun against representative tunnel-segmentation paradigms. mIoU values are per-segment on Seg2Tunnel where available; supervised and voxel/image figures are from}~\texthl  {\cite  {lin2024seg2tunnel}}, \texthl  {and SAM4Tun figures from}~\texthl  {\cite  {ye2025sam4tun}}. \texthl  {``n/r'': per-segment mIoU not reported (geometric methods report cross-section fitting error instead). The comparison is on setup cost as well as accuracy: R4Tun is the only approach that is simultaneously label-free, training-free, and expert-tuning-free while still adapting per tunnel.}}}{18}{table.caption.23}\protected@file@percent }
\newlabel{tab:sota}{{11}{18}{\hl {Positioning R4Tun against representative tunnel-segmentation paradigms. mIoU values are per-segment on Seg2Tunnel where available; supervised and voxel/image figures are from}~\hlcite {lin2024seg2tunnel}, \hl {and SAM4Tun figures from}~\hlcite {ye2025sam4tun}. \hl {``n/r'': per-segment mIoU not reported (geometric methods report cross-section fitting error instead). The comparison is on setup cost as well as accuracy: R4Tun is the only approach that is simultaneously label-free, training-free, and expert-tuning-free while still adapting per tunnel.}}{table.caption.23}{}}
