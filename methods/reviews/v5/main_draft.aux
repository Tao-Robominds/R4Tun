\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Stage~4---Segmenting. The segmenting stage applies Hough-transform line detection~\cite  {duda1972hough} to identify ring boundaries, then constructs template-based prompts and feeds them to SAM~\cite  {kirillov2023sam}. SAM produces 2D segment masks that are reprojected into 3D. \texthl  {K denotes the key segment, B denote base segments, and A denote adjacent segments around the ring.} (Note: rotation is shown for visualisation purposes only.)}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:stage-p}{{6}{7}{Stage~4---Segmenting. The segmenting stage applies Hough-transform line detection~\cite {duda1972hough} to identify ring boundaries, then constructs template-based prompts and feeds them to SAM~\cite {kirillov2023sam}. SAM produces 2D segment masks that are reprojected into 3D. \hl {K denotes the key segment, B denote base segments, and A denote adjacent segments around the ring.} (Note: rotation is shown for visualisation purposes only.)}{figure.caption.6}{}}
\newlabel{fig:stage-p@cref}{{[figure][6][]6}{[1][4][]7}{}{}{}}
