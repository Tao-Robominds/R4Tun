\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \texthl  {FP/FN error map drawn as a ring-by-\mbox  {$\theta $} raster: each horizontal row is one ring, \mbox  {$\theta $} is the circumferential angle, and every point is coloured only as correct, false negative (\mbox  {block$\rightarrow $background}), false positive (\mbox  {background$\rightarrow $block}), or class swap. The grey sidebar shows points per ring; the black plus and purple cross mark the ground-truth and predicted key-block (K) position on each ring. This layout makes the four causes of error directly visible: the single-peaked density sidebar (one preprocessing setting cannot fit every ring); the spread of the K marks across \mbox  {$\theta $} (a staggered anchor that must be re-found per ring), with rows where the predicted K departs from the ground-truth K turning almost entirely to class swap (a mis-located K rotates the whole ring); swaps concentrating toward the \mbox  {$\theta $} extremes of a row (fixed-offset drift far from K); and occasional fully mirrored rows (reversed handedness). Regular tunnel 1-1 (top) is dominated by within-ring class swaps that adaptation reduces from 39\% to 13\%, while complex tunnel 4-1 (bottom) is dominated by baseline under-segmentation (FN 70\%) that adaptation converts into recovered-but-mislabelled blocks (swap 41\%). Unmapped and synthetic points are excluded.}}}{16}{figure.caption.18}\protected@file@percent }
\newlabel{fig:error-map}{{11}{16}{\hl {FP/FN error map drawn as a ring-by-\mbox {$\theta $} raster: each horizontal row is one ring, \mbox {$\theta $} is the circumferential angle, and every point is coloured only as correct, false negative (\mbox {block$\rightarrow $background}), false positive (\mbox {background$\rightarrow $block}), or class swap. The grey sidebar shows points per ring; the black plus and purple cross mark the ground-truth and predicted key-block (K) position on each ring. This layout makes the four causes of error directly visible: the single-peaked density sidebar (one preprocessing setting cannot fit every ring); the spread of the K marks across \mbox {$\theta $} (a staggered anchor that must be re-found per ring), with rows where the predicted K departs from the ground-truth K turning almost entirely to class swap (a mis-located K rotates the whole ring); swaps concentrating toward the \mbox {$\theta $} extremes of a row (fixed-offset drift far from K); and occasional fully mirrored rows (reversed handedness). Regular tunnel 1-1 (top) is dominated by within-ring class swaps that adaptation reduces from 39\% to 13\%, while complex tunnel 4-1 (bottom) is dominated by baseline under-segmentation (FN 70\%) that adaptation converts into recovered-but-mislabelled blocks (swap 41\%). Unmapped and synthetic points are excluded.}}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \texthl  {Why class confusion arises. (a) Blocks are labelled by position: detect the key block K, then place all other blocks by a fixed angular offset shared across rings and tunnels. (b) Within one tunnel, ring point density varies by 17--40\,$\times $ in a single-peaked scanner profile, so no single preprocessing setting fits both the densest and sparsest rings. (c) The K anchor is not fixed: staggered assembly shifts its circumferential position from ring to ring, by up to a third of the arc on a regular tunnel and three quarters on a complex one. (d) Resulting failures: a mis-located K rotates the whole ring's labels, the fixed sector drifts for blocks far from K, and a reversed ring handedness mirrors the labels.}}}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:error-mechanism}{{12}{17}{\hl {Why class confusion arises. (a) Blocks are labelled by position: detect the key block K, then place all other blocks by a fixed angular offset shared across rings and tunnels. (b) Within one tunnel, ring point density varies by 17--40\,$\times $ in a single-peaked scanner profile, so no single preprocessing setting fits both the densest and sparsest rings. (c) The K anchor is not fixed: staggered assembly shifts its circumferential position from ring to ring, by up to a third of the arc on a regular tunnel and three quarters on a complex one. (d) Resulting failures: a mis-located K rotates the whole ring's labels, the fixed sector drifts for blocks far from K, and a reversed ring handedness mirrors the labels.}}{figure.caption.19}{}}
